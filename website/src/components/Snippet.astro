---
import { Code } from "astro:components";

type Language = "graphql" | "json" | "sh" | "ts";

interface Props {
  code: string;
  lang: Language;
  label: string;
}

const { code, lang, label } = Astro.props;
---

<figure class="snippet">
  <figcaption>
    <span>{label}</span>
    <button type="button" class="copy" data-copy={code} aria-label={`Copy ${label}`}>Copy</button>
  </figcaption>
  <Code code={code} lang={lang} theme="tokyo-night" wrap />
</figure>

<script>
  import "../scripts/copy-buttons.ts";
</script>
